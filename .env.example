# Firebase — variables de entorno (NO commitear valores reales)
#
# Opción A — Emulador local de Firestore (recomendado para dev sin proyecto):
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   FIREBASE_PROJECT_ID=technostore-local
#
# Opción B — Service Account como archivo (gitignoreado):
#   GOOGLE_APPLICATION_CREDENTIALS=./server/firebase-service-account.json
#
# Opción C — Variables sueltas (p.ej. Secret Manager inyecta estas al entorno):
#   FIREBASE_PROJECT_ID=tu-project-id
#   FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@tu-project-id.iam.gserviceaccount.com
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Nunca commitees el archivo firebase-service-account.json ni pegues la
# PRIVATE KEY en el repo. Usá Secret Manager / variables de entorno.

FIREBASE_PROJECT_ID=technostore-local
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_APPLICATION_CREDENTIALS=./server/firebase-service-account.json
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

ADMIN_PASSWORD=technostore2026
MERCADOPAGO_ACCESS_TOKEN=

# --- Fase 2: Hub PostgreSQL + Elit B2B ---
# Si DATABASE_URL no está definida, /api/products/live sigue usando Firestore.
DATABASE_URL=postgresql://usuario:password@host:5432/technostore
PG_SSL=1
PG_POOL_MAX=5

ELIT_MODE=sandbox            # sandbox usa fixtures locales; production llama a la API real
ELIT_USER_ID=
ELIT_TOKEN=
ELIT_API_BASE_SANDBOX=https://sandbox.elit.com.ar/api
ELIT_API_BASE_PRODUCTION=https://api.elit.com.ar
ELIT_CATALOG_PATH=/productos
ELIT_STOCK_PATH=/stock

# Reglas del motor de precios (si no se usan las de pricing_config en DB)
USD_ARS_RATE=1550

# --- Fase 3: Mercado Libre Argentina ---
CRON_SECRET=cambiar-por-un-valor-largo-y-aleatorio
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://technostore.ar/api/ml/auth/callback
ML_USER_ID=
ML_API_BASE=https://api.mercadolibre.com
ML_SELLER_ID=
WHATSAPP_APP_SECRET=
DAILY_AUTO_SPEND_CAP_USD=400

# --- Fase 4: Agente de IA ---
LLM_PROVIDER=openai          # openai | gemini (modo OpenAI-compatible)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=                # opcional; por defecto OpenAI o Gemini OpenAI-compat
STORE_BASE_URL=https://technostore.ar
APPROVAL_SECRET=cambiar-por-otro-valor-largo
APPROVAL_BASE_URL=https://carrito-ts-neon.vercel.app
AUTO_APPROVE_USD_LIMIT=150
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
