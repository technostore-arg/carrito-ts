# Firebase — variables de entorno (NO commitear valores reales)
#
# Opción A — Emulador local de Firestore (recomendado para dev sin proyecto):
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   FIREBASE_PROJECT_ID=technostore-local
#
# Opción B — Service Account como archivo (gitignoreado):
#   GOOGLE_APPLICATION_CREDENTIALS=./server/firebase-service-account.json
#
# Opción C — Variables sueltas (p.ej. Secret Manager inyecta estas al entorno):
#   FIREBASE_PROJECT_ID=tu-project-id
#   FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@tu-project-id.iam.gserviceaccount.com
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Nunca commitees el archivo firebase-service-account.json ni pegues la
# PRIVATE KEY en el repo. Usá Secret Manager / variables de entorno.

FIREBASE_PROJECT_ID=technostore-local
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_APPLICATION_CREDENTIALS=./server/firebase-service-account.json
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

ADMIN_PASSWORD=technostore2026
MERCADOPAGO_ACCESS_TOKEN=
